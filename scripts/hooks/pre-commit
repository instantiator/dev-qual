#!/usr/bin/env bash
# Git pre-commit hook. Two stages, in this order:
#   1. the fast quality gate (format + lint + typecheck), run on the staged
#      snapshot: exactly what will be committed, nothing unstaged or untracked
#   2. the project's own file-modifying steps, re-staged into the commit
# Installed by setup-hooks.sh. Kept fast on purpose, so nobody disables it.
set -euo pipefail

# Locate check.sh: next to this hook (core.hooksPath install), then in the
# repo's dev-qual submodule (copied-hook install), then its pre-rename name.
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
TOP="$(git rev-parse --show-toplevel)"
CHECK=""
for candidate in "$HOOK_DIR/../check.sh" "$TOP/dev-qual/scripts/check.sh" "$TOP/dev-environment/scripts/check.sh"; do
  if [ -f "$candidate" ]; then CHECK="$candidate"; break; fi
done
if [ -z "$CHECK" ]; then
  echo "pre-commit: dev-qual check.sh not found; skipping quality gate." >&2
  exit 0
fi

# 1. Check first: no point regenerating anything for a commit that will fail.
#    The check runs on an export of the index, so unstaged edits (or another
#    agent's half-written file) can neither block this commit nor hide a
#    problem in what is staged. The working tree is never touched.
SNAPSHOT="$(mktemp -d "${TMPDIR:-/tmp}/dev-qual-precommit.XXXXXX")"
trap 'rm -rf "$SNAPSHOT"' EXIT
git -C "$TOP" checkout-index --all --prefix="$SNAPSHOT/"
# Installed tooling is untracked, so link it in for lint/typecheck scripts —
# at any depth, since each monorepo workspace can have its own.
(cd "$TOP" && find . \( -name node_modules -o -name .venv -o -name venv \) -type d -prune \
  -not -path './.git/*') | while IFS= read -r dep; do
  if [ -d "$SNAPSHOT/$(dirname "$dep")" ]; then ln -s "$TOP/$dep" "$SNAPSHOT/$dep"; fi
done
# Submodules are exported as empty directories; link in their checkouts, so
# config that extends a submodule's files (dev-qual's among them) resolves.
if [ -f "$TOP/.gitmodules" ]; then
  git config --file "$TOP/.gitmodules" --get-regexp '\.path$' | cut -d' ' -f2- |
    while IFS= read -r sub; do
      if [ -d "$TOP/$sub" ]; then
        rm -rf "${SNAPSHOT:?}/$sub"
        mkdir -p "$(dirname "$SNAPSHOT/$sub")"
        ln -s "$TOP/$sub" "$SNAPSHOT/$sub"
      fi
    done
fi
bash "$CHECK" --fast --project "$SNAPSHOT"

# 2. Steps that rewrite files — formatting, generated docs, licence lists.
#    The project owns this script; with no script there is nothing to do.
#    NB. the full gate runs again at pre-push, which is what catches a fixup
#    that leaves the tree failing.
FIXUPS="$TOP/scripts/pre-commit-fixups.sh"
[ -x "$FIXUPS" ] || exit 0

# Record what was staged, and which of those files also have unstaged changes,
# BEFORE running the fixups — afterwards the two are indistinguishable.
STAGED="$(git diff --name-only --cached)"
PARTIAL="$(git diff --name-only)"

echo ""
echo "pre-commit: running $FIXUPS"
bash "$FIXUPS"

# Re-stage only files that were already staged. A file staged with `git add -p`
# has hunks its author deliberately held back; re-adding it wholesale would
# commit them too, so those are left alone and named instead.
HELD_BACK=""
while read -r file; do
  [ -n "$file" ] || continue
  if printf '%s\n' "$PARTIAL" | grep -Fxq "$file"; then
    HELD_BACK="$HELD_BACK
$file"
  else
    git add -- "$file"
  fi
done <<EOF
$STAGED
EOF

if [ -n "$HELD_BACK" ]; then
  echo "" >&2
  echo "pre-commit: these files were only partially staged, so any fixup changes" >&2
  echo "to them are NOT in this commit — review and stage them yourself:" >&2
  printf '%s\n' "$HELD_BACK" | sed '/^$/d; s/^/  /' >&2
fi
